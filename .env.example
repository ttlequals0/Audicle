# Required by Docker Compose: set an existing release tag from GitHub Releases.
BUILD_VERSION=

# Configure services, feed URLs, narration, retention, and security in Settings
# after startup, or through the authenticated API. Existing tuning variables
# remain supported as defaults; saved settings take precedence.

# Optional deployment settings. Leave these commented to use the defaults.
# DATA_DIR=/data
# WEB_WORKERS=2
# SESSION_SECRET_KEY=
# The session signing key is generated and persisted when not supplied.

# CPU hosts must also select the -cpu image and remove the GPU reservation.
# TTS_DEVICE=cuda
# MALLOC_ARENA_MAX=2

# Change these together only if the renderer subnet overlaps another network.
# RENDER_NETWORK_SUBNET=172.30.0.0/24
# RENDER_CLIENT_IP=172.30.0.2
# RENDER_PROXY_IP=172.30.0.3

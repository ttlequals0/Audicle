{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "primary": {
      "value": "#1ce783",
      "description": "Audicle green. Primary brand color and UI accent."
    },
    "background": {
      "value": "#040405",
      "description": "Rich black. Primary page background."
    },
    "paper": {
      "value": "#0a0a0c",
      "description": "Card and section background, slightly lighter than page."
    },
    "surface": {
      "value": "#15151a",
      "description": "Input fields and inset surfaces."
    },
    "line": {
      "value": "#26262e",
      "description": "Borders and dividers."
    },
    "text": {
      "value": "#f5f5f5",
      "description": "Primary text."
    },
    "text_dim": {
      "value": "#9a9aaa",
      "description": "Secondary text."
    },
    "text_mute": {
      "value": "#9a9aaa",
      "description": "Readable helper text; shares the secondary text color."
    },
    "danger": {
      "value": "#ff5252",
      "description": "Errors and destructive actions."
    },
    "line_strong": {
      "value": "#3a3a45",
      "description": "Hovered card and menu borders."
    },
    "control": {
      "value": "#6b6b78",
      "description": "Decorative inactive controls, never helper text."
    },
    "primary_pressed": {
      "value": "#16d076",
      "description": "Pressed primary controls."
    },
    "danger_surface": {
      "value": "#4a1f1f",
      "description": "Destructive action borders and error tags."
    },
    "danger_hover": {
      "value": "#ff7b7b",
      "description": "Error text and hovered destructive actions."
    },
    "warning_surface": {
      "value": "#3b2b0a",
      "description": "Processing status background."
    },
    "warning_text": {
      "value": "#fcd67a",
      "description": "Processing status text."
    }
  },
  "typography": {
    "family_sans": {
      "value": "Satoshi, system-ui, -apple-system, sans-serif",
      "description": "Headings, navigation, labels and body. Approved fallback for Hulu Graphik; loaded via Fontshare."
    },
    "family_mono": {
      "value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "description": "System monospace for code editors and raw technical values; ordinary UI text uses Satoshi."
    },
    "letter_spacing": {
      "wordmark": {
        "value": "-0.02em",
        "description": "Tracking for the Audicle wordmark."
      },
      "label": {
        "value": "0.08em",
        "description": "Tracking for uppercase mono labels and tags."
      }
    }
  },
  "radius": {
    "small": {
      "value": "6px"
    },
    "medium": {
      "value": "8px"
    },
    "large": {
      "value": "12px"
    }
  }
}

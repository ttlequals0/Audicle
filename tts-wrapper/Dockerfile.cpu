# syntax=docker/dockerfile:1.7

# CPU-only variant. Same code, smaller image (no CUDA toolkit), substantially
# slower runtime (5-10x per build plan). Set TTS_DEVICE=cpu in .env when using
# this image.
#
# Multi-arch (linux/amd64 and linux/arm64); the GPU Dockerfile is amd64-only.
#
# There is no published ``pytorch/pytorch:*-cpu`` tag, so this builds on a plain
# Python base (PYVER, as in Dockerfile) and installs the CPU-only torch
# wheel from PyTorch's CPU index before the rest of the deps, so chatterbox-tts
# reuses it instead of pulling the much larger CUDA build.
ARG PYVER=3.14
FROM ghcr.io/astral-sh/uv:0.13.9 AS uv
FROM python:${PYVER}-slim AS runtime
COPY --from=uv /uv /uvx /bin/

# Cache locations target writable paths so the image runs as a non-root user
# (the compose ``user: 1000:1000``). Model caches live on the persistent
# ``/data`` volume; the rest go to image-local ``/tmp``. The old
# ``/root/.cache`` defaults are mode-700 root-owned and crash uid 1000.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/data/hf_cache \
    TTS_HOME=/data/tts_home \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    NUMBA_CACHE_DIR=/tmp/numba_cache \
    MPLCONFIGDIR=/tmp/mpl

# libsndfile for soundfile WAV IO (the healthcheck uses Python, not curl). The build
# toolchain and git are installed later, only for the engine install, and purged in
# the same layer.
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# libsqlite3-0 from Debian sid clears CVE-2026-119373, CVE-2026-119374 and CVE-2026-119379.
# Drop this block when trixie ships the fix.
# The build enforces the fixed versions and fails if the sid install adds, removes or changes any other package.
RUN pkgs='libsqlite3-0=3.54.1-2' \
    && printf 'Types: deb\nURIs: http://deb.debian.org/debian\nSuites: sid\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n' > /etc/apt/sources.list.d/sid.sources \
    && printf 'Package: *\nPin: release a=unstable\nPin-Priority: 100\n' > /etc/apt/preferences.d/sid \
    && apt-get update \
    && dpkg-query -W -f='${Package} ${Version}\n' > /tmp/pkgs.before \
    && apt-get install -y --no-install-recommends $(for e in $pkgs; do printf '%s/sid ' "${e%%=*}"; done) \
    && dpkg-query -W -f='${Package} ${Version}\n' > /tmp/pkgs.after \
    && rm -f /etc/apt/sources.list.d/sid.sources /etc/apt/preferences.d/sid \
    && rm -rf /var/lib/apt/lists/* \
    && for e in $pkgs; do \
         dpkg --compare-versions "$(dpkg-query -W -f='${Version}' "${e%%=*}")" ge "${e#*=}" || exit 1; \
       done \
    && unexpected="$(diff /tmp/pkgs.before /tmp/pkgs.after | sed -n 's/^[<>] \([^ ]*\) .*/\1/p' | sort -u | grep -vxF $(for e in $pkgs; do printf -- '-e %s ' "${e%%=*}"; done) || true)" \
    && if [ -n "$unexpected" ]; then echo "ERROR: the sid install changed other packages: $unexpected" >&2; exit 1; fi \
    && rm -f /tmp/pkgs.before /tmp/pkgs.after

WORKDIR /app
COPY pyproject.toml uv.lock LICENSE ./
# Every module main.py imports must be listed here (see Dockerfile).
COPY config.py engine.py log_setup.py main.py memory.py chatterbox_engine.py whisper_verify.py install_engine.sh entrypoint.sh ./
# Install torch and torchaudio from the CPU index before the remaining locked
# dependencies. TorchAudio 2.11 uses PyTorch's stable ABI for PyTorch 2.11+.
# build-essential: spacy-pkuseg publishes no cp314 wheel and is compiled from its
# locked sdist. git: the chatterbox backend installs resemble-perth (a git+https
# dependency). Both are installed and purged in this one layer.
RUN pip install --no-cache-dir torch==2.13.0 torchaudio==2.11.0 \
        --index-url https://download.pytorch.org/whl/cpu \
    && apt-get update \
    && apt-get install -y --no-install-recommends build-essential git \
    && sh install_engine.sh \
    # The build toolchain (and with it linux-libc-dev, a magnet for unfixable
    # kernel-header CVEs) is only needed to compile native extensions above.
    # Purge it from the shipped image; the compiled wheels need only the
    # runtime shared libs, which are pinned manual so autoremove keeps them.
    && apt-mark manual libstdc++6 libgomp1 libgcc-s1 ca-certificates libsndfile1 \
    && apt-get purge -y build-essential git \
    && apt-get autoremove -y --purge \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 audicle \
    && mkdir -p /data /tmp/.cache/torch/kernels /tmp/numba_cache /tmp/mpl \
    && chown -R audicle:audicle /data /tmp/.cache /tmp/numba_cache /tmp/mpl
USER audicle

EXPOSE 8000

# Single-source version: the build passes the repo-root VERSION value here
# (`--build-arg WRAPPER_VERSION=$(cat VERSION)`) since this build context is
# tts-wrapper/ and can't read the root file. main.py reads AUDICLE_WRAPPER_VERSION.
ARG WRAPPER_VERSION=0.0.0
ENV AUDICLE_WRAPPER_VERSION=${WRAPPER_VERSION}
# start-period is generous: the first boot downloads multi-GB model weights from
# HuggingFace before the model loads and /health/live turns 200.
HEALTHCHECK --interval=30s --timeout=10s --retries=5 --start-period=300s \
    CMD python -I -c "import urllib.request,sys; sys.exit(0 if 200 <= urllib.request.urlopen('http://localhost:8000/health/live', timeout=4).status < 300 else 1)"
CMD ["sh", "/app/entrypoint.sh"]
